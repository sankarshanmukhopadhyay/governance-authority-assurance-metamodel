{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/experimental/0.9.0-research/schemas/governance-state.schema.json",
  "title": "Governance State (Experimental)",
  "description": "Experimental GAAM v0.9.0 research artefact. Non-normative and non-conformant.",
  "required": [
    "type",
    "gaamVersion",
    "status",
    "normativeStatus",
    "effectiveAt",
    "permittedOperations",
    "state",
    "systemId"
  ],
  "properties": {
    "type": {
      "const": "governance-state"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "status": {
      "const": "experimental"
    },
    "normativeStatus": {
      "const": "non-normative"
    },
    "systemId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "normal",
        "read-only",
        "no-new-issuance",
        "status-only",
        "emergency-revocation-only",
        "cached-verification",
        "supervised",
        "manual-fallback",
        "safe-shutdown"
      ]
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "permittedOperations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trigger": {
      "type": "string"
    },
    "reviewAuthority": {
      "type": "string"
    }
  }
}
