{
  "id": "urn:gaam:informative:evidence-catalogue:0.9.0",
  "type": "gaam-informative-evidence-catalogue",
  "gaamVersion": "0.9.0",
  "status": "informative",
  "normativeEffect": "none",
  "entries": [
    {"id":"EVD-GOV-001","class":"governance-package","producer":"governance-authority","supports":["applicable-rules","precedence","ownership","version"],"verification":["authority","identifier","version","integrity","approval-history"],"lifecycleTriggers":["approval","supersession","withdrawal"],"independenceNote":"Operator production is permitted; accountable approval must be attributable."},
    {"id":"EVD-AUT-001","class":"authority-status","producer":"competent-authority-or-authoritative-registry","supports":["authority-source","scope","validity","status"],"verification":["issuer-competence","scope","effective-time","revocation-state"],"lifecycleTriggers":["authority-transition","source-update"],"independenceNote":"The relying implementation must not be treated as the authoritative source solely by assertion."},
    {"id":"EVD-DEL-001","class":"delegation-chain","producer":"principal-delegator-or-delegation-service","supports":["purpose","effects","duration","jurisdiction","redelegation"],"verification":["parent-authority","attenuation","chain-integrity","current-status"],"lifecycleTriggers":["parent-transition","child-transition"],"independenceNote":"The evaluator should disclose relationships to delegation parties."},
    {"id":"EVD-STR-001","class":"schema-validation","producer":"build-system-validator-or-assessor","supports":["structural-validity"],"verification":["schema-identifier","validator-version","input-digest","errors"],"lifecycleTriggers":["artifact-change","schema-change"],"independenceNote":"Self-produced evidence may support L1 when disclosed."},
    {"id":"EVD-STR-002","class":"profile-dependency-closure","producer":"conformance-harness-or-assessor","supports":["profile-applicability","dependency-closure"],"verification":["manifest-version","dependency-resolution","missing-profiles"],"lifecycleTriggers":["profile-change","gaam-version-change"],"independenceNote":"Reviewers should be able to reproduce the result from canonical manifests."},
    {"id":"EVD-INT-001","class":"package-integrity","producer":"build-or-release-process","supports":["artifact-identity","modification-detection"],"verification":["scope","hashes","signatures","source-revision"],"lifecycleTriggers":["package-build","publication"],"independenceNote":"Separate signing or reproducible build evidence may strengthen assurance."},
    {"id":"EVD-BEH-001","class":"behavioural-test","producer":"test-harness","supports":["governance-invariant-enforcement"],"verification":["test-input","expected-result","actual-result","target-version"],"lifecycleTriggers":["code-change","configuration-change","policy-change","dependency-change"],"independenceNote":"Disclose the relationship between test author and operator."},
    {"id":"EVD-BEH-002","class":"failure-mode-test","producer":"test-harness-or-resilience-exercise","supports":["expiry","revocation","stale-state","partition-behaviour","failure-policy"],"verification":["timing","injected-condition","enforcement-response","recovery"],"lifecycleTriggers":["architecture-change","policy-change"],"independenceNote":"Independent witnessing may be appropriate for higher-risk claims."},
    {"id":"EVD-DEC-001","class":"decision-receipt","producer":"runtime-decision-point","supports":["decision-authority","policy","evidence","outcome","accountability"],"verification":["target-binding","time-binding","policy-binding","evidence-binding","accountable-party"],"lifecycleTriggers":["decision","sampling-period"],"independenceNote":"Receipt integrity and completeness require verification beyond source assertion."},
    {"id":"EVD-LIF-001","class":"lifecycle-event-history","producer":"authoritative-event-source","supports":["issuance","activation","suspension","revocation","expiry","remedy"],"verification":["ordering","transition-authority","effective-time","affected-descendants"],"lifecycleTriggers":["material-transition"],"independenceNote":"Controls should make equivocation and selective history detectable."},
    {"id":"EVD-OPS-001","class":"operational-monitoring","producer":"operator-or-monitoring-service","supports":["continued-control-operation"],"verification":["coverage","collection-method","gaps","alerts","retained-history"],"lifecycleTriggers":["observation-window"],"independenceNote":"External monitoring does not automatically establish assessment independence."},
    {"id":"EVD-INC-001","class":"incident-and-corrective-action","producer":"incident-authority-or-operator","supports":["control-failure","impact","correction","claim-consequence"],"verification":["detection","affected-scope","root-cause","corrective-action","verification"],"lifecycleTriggers":["incident-detection","closure","follow-up"],"independenceNote":"Material incidents should be available to the claim assessor."},
    {"id":"EVD-REM-001","class":"review-and-remedy","producer":"decision-operator-review-authority-or-remedy-authority","supports":["notice","appeal","review","correction"],"verification":["standing","deadlines","review-independence","outcome","downstream-propagation"],"lifecycleTriggers":["challenge","review","remedy"],"independenceNote":"The review authority should be distinguishable from the original decision authority where required."},
    {"id":"EVD-PRI-001","class":"privacy-and-disclosure-assessment","producer":"privacy-reviewer-or-accountable-authority","supports":["data-minimisation","correlation-risk","access","retention","disclosure"],"verification":["data-flows","purposes","audiences","risks","mitigations"],"lifecycleTriggers":["data-change","purpose-change","architecture-change"],"independenceNote":"Affected-party input or independent review may be necessary in high-impact contexts."},
    {"id":"EVD-SEC-001","class":"security-assessment","producer":"security-team-or-assessor","supports":["integrity","availability","confidentiality","attack-resistance"],"verification":["scope","method","findings","severity","remediation","retest"],"lifecycleTriggers":["material-release","incident","threat-change"],"independenceNote":"Assessor competence and independence should be explicit."},
    {"id":"EVD-INTOP-001","class":"interoperability-test","producer":"multiple-implementers-or-test-coordinator","supports":["shared-artifact-interpretation","cross-implementation-processing"],"verification":["producer-consumer-matrix","versions","semantic-outcomes","failures"],"lifecycleTriggers":["implementation-change","specification-change"],"independenceNote":"No single implementation should control every side of the test."},
    {"id":"EVD-ASS-001","class":"assessment-report","producer":"assessor","supports":["method","sampling","findings","exceptions","assurance-conclusion"],"verification":["scope","competence","independence","evidence-reviewed","validity"],"lifecycleTriggers":["review-date","expiry","incident","material-target-change"],"independenceNote":"The relationship must satisfy the independence required by the claimed level."},
    {"id":"EVD-CLA-001","class":"conformance-claim-history","producer":"claim-issuer-or-registry","supports":["issuance","limitation","expiry","suspension","withdrawal","supersession"],"verification":["claim-identity","evidence-references","authority","status-transitions"],"lifecycleTriggers":["claim-lifecycle-change"],"independenceNote":"Disclose the claim issuer's relationship to the target."}
  ]
}
