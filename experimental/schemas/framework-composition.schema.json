{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/experimental/0.9.0-research/schemas/framework-composition.schema.json",
  "title": "Framework Composition (Experimental)",
  "description": "Experimental GAAM v0.9.0 research artefact. Non-normative and non-conformant.",
  "required": [
    "type",
    "gaamVersion",
    "status",
    "normativeStatus",
    "frameworkId",
    "relationships"
  ],
  "properties": {
    "type": {
      "const": "framework-composition"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "status": {
      "const": "experimental"
    },
    "normativeStatus": {
      "const": "non-normative"
    },
    "frameworkId": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetFramework",
          "relationship",
          "precedence"
        ],
        "properties": {
          "targetFramework": {
            "type": "string"
          },
          "relationship": {
            "enum": [
              "extends",
              "specialises",
              "profiles",
              "depends-on",
              "imports-requirements-from",
              "overrides",
              "recognises"
            ]
          },
          "precedence": {
            "type": "integer",
            "minimum": 0
          },
          "inheritedRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
