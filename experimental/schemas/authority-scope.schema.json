{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/experimental/0.9.0-research/schemas/authority-scope.schema.json",
  "title": "Authority Scope (Experimental)",
  "description": "Experimental GAAM v0.9.0 research artefact. Non-normative and non-conformant.",
  "required": [
    "type",
    "gaamVersion",
    "status",
    "normativeStatus",
    "actions",
    "objects",
    "purpose",
    "validFrom",
    "validUntil"
  ],
  "properties": {
    "type": {
      "const": "authority-scope"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "status": {
      "const": "experimental"
    },
    "normativeStatus": {
      "const": "non-normative"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "valueLimit": {
      "type": "number",
      "minimum": 0
    },
    "frequencyLimit": {
      "type": "integer",
      "minimum": 1
    },
    "delegationDepth": {
      "type": "integer",
      "minimum": 0
    },
    "supervisionMode": {
      "enum": [
        "unattended",
        "reviewed",
        "approval-required",
        "dual-control"
      ]
    }
  }
}
