{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/experimental/0.9.0-research/schemas/assurance-dependency.schema.json",
  "title": "Assurance Dependency (Experimental)",
  "description": "Experimental GAAM v0.9.0 research artefact. Non-normative and non-conformant.",
  "required": [
    "type",
    "gaamVersion",
    "status",
    "normativeStatus",
    "assuranceObject",
    "limitations",
    "relianceType",
    "sourceAssessment"
  ],
  "properties": {
    "type": {
      "const": "assurance-dependency"
    },
    "gaamVersion": {
      "const": "0.9.0"
    },
    "status": {
      "const": "experimental"
    },
    "normativeStatus": {
      "const": "non-normative"
    },
    "assuranceObject": {
      "type": "string"
    },
    "sourceAssessment": {
      "type": "string"
    },
    "relianceType": {
      "enum": [
        "inherit",
        "compose",
        "rely-on",
        "supplement",
        "downgrade"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "invalidatingEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    }
  }
}
