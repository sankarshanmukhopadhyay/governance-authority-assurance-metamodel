{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/governance-authority-assurance-metamodel/v0.9.0/examples/pattern-manifest.schema.json",
  "title": "GAAM Implementation Pattern Manifest",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "maturity",
    "gaamVersion",
    "implementationDomain",
    "profiles",
    "requirements",
    "actors",
    "authoritySources",
    "enforcementPoints",
    "evidenceProducers",
    "reviewAuthorities",
    "artifacts",
    "schemaFixtures",
    "behaviouralVectors",
    "positiveScenarios",
    "negativeScenarios",
    "limitations",
    "validationCommand"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^gaam:pattern:"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "stable",
        "deprecated"
      ]
    },
    "maturity": {
      "enum": [
        "conceptual",
        "structural",
        "behavioural",
        "operational",
        "assurance-ready",
        "interoperability-tested"
      ]
    },
    "gaamVersion": {
      "type": "string"
    },
    "implementationDomain": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authoritySources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enforcementPoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceProducers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewAuthorities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "behaviouralVectors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "positiveScenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "negativeScenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "schemaFixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "expectedValid"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "authority",
              "delegation",
              "decision-receipt",
              "governance-event",
              "remedy"
            ]
          },
          "expectedValid": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "supportingExamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycleStates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validationCommand": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
